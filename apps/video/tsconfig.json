{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@workspace/ui/*": [
        "../../packages/ui/src/*"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src"
  ]
}