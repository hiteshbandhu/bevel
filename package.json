{
  "name": "bevel",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "storybook": "pnpm --filter storybook dev",
    "check:tokens": "node scripts/check-tokens.mjs",
    "registry:build": "node scripts/build-registry.mts && shadcn build registry.json --output apps/web/public/r"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "postcss": "8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.21.5",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiteshbandhu/bevel"
  },
  "homepage": "https://bevel-ui.vercel.app"
}
